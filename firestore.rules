rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfis de Usuário: Leitura pública, criação/alteração apenas pelo próprio dono
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Avaliações e Notas: Leitura pública, criação/edição vinculada ao ID do autor
    match /avaliar/{ratingId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Listas Públicas: Leitura livre, criação e edição exclusivas do criador
    match /lists/{listId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'authorPhoto', 'kind', 'gameId',
          'text', 'mediaUrl', 'mediaType', 'createdAt', 'likes'
        ])
        && request.resource.data.keys().hasAll([
          'authorId', 'authorName', 'authorPhoto', 'kind', 'gameId',
          'text', 'mediaUrl', 'mediaType', 'createdAt', 'likes'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 60
        && (
          request.resource.data.authorName == request.auth.uid
          || request.resource.data.authorName == request.auth.token.get('name', '')
          || request.resource.data.authorName == 'Usuário'
        )
        && request.resource.data.authorPhoto is string
        && request.resource.data.authorPhoto.size() <= 500
        && (request.resource.data.authorPhoto == '' || request.resource.data.authorPhoto.matches('https://.*'))
        && request.resource.data.kind in ['discussion', 'bug', 'translation', 'game-request']
        && request.resource.data.gameId is string
        && request.resource.data.gameId.matches('^[a-z0-9-]{0,80}$')
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1200
        && request.resource.data.mediaType in ['none', 'image', 'gif', 'youtube']
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 2000
        && (
          (request.resource.data.mediaType == 'none' && request.resource.data.mediaUrl == '')
          || (request.resource.data.mediaType in ['image', 'gif'] && request.resource.data.mediaUrl.matches('https://.*'))
          || (request.resource.data.mediaType == 'youtube'
            && request.resource.data.mediaUrl.matches('https://youtu\\.be/[A-Za-z0-9_-]{11}'))
        )
        && (request.resource.data.text.size() > 0 || request.resource.data.mediaUrl.size() > 0)
        && request.resource.data.createdAt == request.time
        && request.resource.data.likes is map
        && request.resource.data.likes.keys().size() == 0;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is map
        && resource.data.likes is map
        && request.resource.data.likes.diff(resource.data.likes).affectedKeys().hasOnly([request.auth.uid])
        && (
          (
            request.resource.data.likes.diff(resource.data.likes).addedKeys().hasOnly([request.auth.uid])
            && request.resource.data.likes[request.auth.uid] == true
          )
          || (
            request.resource.data.likes.diff(resource.data.likes).removedKeys().hasOnly([request.auth.uid])
            && !request.resource.data.likes.keys().hasAny([request.auth.uid])
          )
        );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Bloqueio padrão de segurança para qualquer outra coleção não mapeada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
