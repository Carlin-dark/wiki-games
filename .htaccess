RewriteEngine On
RewriteBase /

AddType application/xml .xml
AddDefaultCharset UTF-8

# Caso o arquivo real exista, serve ele normalmente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todas as rotas internas da Wiki devem cair no index da SPA
RewriteRule ^ /index.html [L,QSA]
